# ─── App ─────────────────────────────────────────────────────────────────────

# Secret used to sign NextAuth session JWTs. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="..."

# Full origin of the app — must match exactly (no trailing slash).
# Dev: http://localhost:3000 | Prod: https://lights-and-vessels.com
NEXTAUTH_URL="..."

# Same origin, exposed to the browser for SEO/sitemap/OG links.
NEXT_PUBLIC_SITE_URL="..."

# Comma-separated list of Google email addresses that are allowed to access /admin.
# E.g. "artist@gmail.com,omri@gmail.com"
ADMIN_EMAILS="..."


# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create an OAuth 2.0 client at https://console.cloud.google.com/apis/credentials
# Authorized JS origin: https://lights-and-vessels.com
# Authorized redirect URI: https://lights-and-vessels.com/api/auth/callback/google

GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."


# ─── Supabase ────────────────────────────────────────────────────────────────

# Prisma database connection via PgBouncer (serverless-safe, port 6543).
# Supabase dashboard → Project Settings → Database → Connection string → Transaction pooler.
# Append: ?pgbouncer=true&connection_limit=1
DATABASE_URL="..."

# Direct Postgres connection used only by `prisma migrate deploy` (port 5432).
# Supabase dashboard → Project Settings → Database → Connection string → Direct connection.
DIRECT_URL="..."

# Your Supabase project URL — used by the storage client.
# Supabase dashboard → Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL="..."

# Public anon key — safe to expose in the browser, read-only by default.
# Supabase dashboard → Project Settings → API → anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."

# Service-role key — server-only, never expose. Needed to write files to Storage.
# Supabase dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY="..."

# Name of the public Storage bucket that holds product/content images.
# Create it in Supabase dashboard → Storage → New bucket (public). E.g. "site-images".
SUPABASE_STORAGE_BUCKET="..."


# ─── Morning (Green Invoice — payments + invoicing) ───────────────────────────

# API base URL. Sandbox: https://sandbox.d.greeninvoice.co.il/api/v1
# Production: https://api.greeninvoice.co.il/api/v1
MORNING_API_BASE="..."

# API key ID + secret — generated in Morning dashboard → Developers → API keys.
# Sandbox keys only work against the sandbox base URL and vice versa.
MORNING_API_KEY_ID="..."
MORNING_API_SECRET="..."

# Plugin ID required by Morning for hosted payment forms.
# Morning dashboard → Developers → Plugins → find or create a plugin → copy its id field.
MORNING_PLUGIN_ID="..."

# Document type issued on successful payment.
# 400 = קבלה (receipt) — correct for עוסק פטור.
# 320 = חשבונית מס + קבלה — only if the artist becomes עוסק מורשה.
MORNING_DEFAULT_DOC_TYPE="400"

# HMAC secret used to verify IPN (webhook) requests from Morning.
# Morning dashboard → Developers → Webhooks → register the notify URL → copy the secret.
# If unset, signature verification is skipped with a warning (dev only).
MORNING_WEBHOOK_SECRET="..."


# ─── Email ────────────────────────────────────────────────────────────────────

# Which provider to use for transactional email: 'resend' or 'gmail'.
# Can also be toggled per-environment from the admin Site Content editor.
EMAIL_PROVIDER="..."

# Display name shown in the From field of all outgoing emails.
EMAIL_FROM_NAME="..."

# Resend — https://resend.com → API Keys → Create key.
# From address: dev can use onboarding@resend.dev; prod needs a verified domain sender.
RESEND_API_KEY="..."
RESEND_FROM_EMAIL="..."

# Gmail SMTP — alternative to Resend.
# Requires Google account with 2FA enabled.
# App password: https://myaccount.google.com/apppasswords → create a 16-char password.
# GMAIL_USER is the full Gmail address; GMAIL_APP_PASSWORD is the 16-char password (NOT your login password).
GMAIL_USER="..."
GMAIL_APP_PASSWORD="..."


# ─── Cron / stock ────────────────────────────────────────────────────────────

# Random secret that gates the /api/orders/sweep endpoint.
# Generate with: openssl rand -hex 32
# Set the same value in Vercel → Settings → Environment Variables,
# and configure Vercel Cron to send it as: Authorization: Bearer <secret>
CRON_SECRET="..."

# How long (minutes) a pending order holds its stock reservation before the sweep releases it.
# Default: 30. The Vercel Cron runs once daily on the free plan, so 60+ is more practical.
ORDER_RESERVATION_TTL_MINUTES=60
