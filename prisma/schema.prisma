generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id             String         @id @default(cuid())
  name_he        String
  name_en        String?
  slug           String         @unique
  description_he String
  description_en String?
  price          Float
  comparePrice   Float?
  category       String?
  tags_he        String?
  tags_en        String?
  images         ProductImage[]
  inStock        Boolean        @default(true)
  stockCount     Int            @default(0)
  featured       Boolean        @default(false)
  published      Boolean        @default(false)
  orderItems     OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt_he    String?
  alt_en    String?
  order     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}

model Order {
  id                    String            @id @default(cuid())
  orderNumber           String            @unique
  status                String            @default("pending")
  customerName          String
  customerEmail         String
  shippingMethod        String            @default("post")
  shippingAddress       String
  phone                 String?
  items                 OrderItem[]
  subtotal              Float
  shippingCost          Float             @default(0)
  total                 Float
  locale                String            @default("he")
  morningPaymentFormId  String?
  morningPaymentFormUrl String?
  morningTransactionId  String?
  morningDocumentId     String?
  morningDocumentNumber String?
  morningDocumentUrl    String?
  paidAt                DateTime?
  documents             MorningDocument[]
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model MorningDocument {
  id         String   @id @default(cuid())
  morningId  String   @unique
  type       Int
  number     String
  amount     Float
  currency   String   @default("ILS")
  status     String   @default("issued")
  url        String?
  issuedAt   DateTime
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId    String?
  rawPayload String?
  createdAt  DateTime @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  price     Float
  product   Product @relation(fields: [productId], references: [id])
  productId String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value_he  String
  value_en  String?
  type      String   @default("text")
  updatedAt DateTime @updatedAt
}

model SiteContentDraft {
  key      String   @id
  value_he String
  value_en String?
  type     String   @default("text")
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id          String          @id @default(cuid())
  title_he    String
  title_en    String?
  slug        String          @unique
  excerpt_he  String
  excerpt_en  String?
  body_he     String
  body_en     String?
  author      String          @default("אלון בראל")
  status      String          @default("draft")
  publishedAt DateTime?
  images      BlogPostImage[]
  tags        BlogPostTag[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, publishedAt])
}

model BlogPostImage {
  id     String   @id @default(cuid())
  url    String
  alt_he String?
  alt_en String?
  order  Int      @default(0)
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
}

model BlogTag {
  id        String        @id @default(cuid())
  name_he   String        @unique
  name_en   String?
  slug      String        @unique
  order     Int           @default(0)
  posts     BlogPostTag[]
  createdAt DateTime      @default(now())
}

model BlogPostTag {
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  String

  @@id([postId, tagId])
  @@index([tagId])
}
